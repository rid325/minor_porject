# Create a MongoDB Atlas database user and allow the app's IP in Atlas Network Access.
# Copy this file to .env, then replace the example URI with your Atlas connection URI.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=yojna_connect

# Optional location of the source workbook used by the MongoDB importer.
# SCHEME_WORKBOOK_PATH=D:/path/to/scheme_research_register.xlsx

# Keep false for local HTTP development. Set true behind HTTPS in production.
AUTH_COOKIE_SECURE=false

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key across restarts. Existing documents require their original key.
# DOCUMENT_STORAGE_KEY=
# Optional Cloudinary storage for new uploads.
# DOCUMENT_STORAGE_PROVIDER=cloudinary
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional absolute path if Tesseract is not available on the backend PATH.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata

# Optional backend credentials for AI-assisted document correction guides.
# GEMINI_API_KEY=
# GEMINI_RESOLUTION_MODEL=gemini-3.5-flash-lite
# OpenAI is used when GEMINI_API_KEY is absent.
# OPENAI_API_KEY=
# DOCUMENT_RESOLUTION_MODEL=gpt-4.1-mini


OCR_SPACE_API_KEY=
# DOCUMENT_OCR_LOW_THRESHOLD=0.70
# DOCUMENT_OCR_HIGH_THRESHOLD=0.90
# Scheme alerts. Enable the worker after configuring the providers.
# SCHEME_NOTIFICATIONS_ENABLED=false
# NOTIFICATION_APP_URL=https://your-app.example
# SCHEME_NOTIFICATION_DEADLINES={}

# BREVO_API_KEY=
# NOTIFICATION_EMAIL_FROM=
