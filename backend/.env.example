# Create a MongoDB Atlas database user and allow the app's IP in Atlas Network Access.
# Copy this file to .env, then replace the example URI with your Atlas connection URI.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=yojna_connect

# Optional location of the source workbook used by the MongoDB importer.
# SCHEME_WORKBOOK_PATH=D:/path/to/scheme_research_register.xlsx

# Keep false for local HTTP development. Set true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
